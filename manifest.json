{
  "manifest_version": 3,
  "name": "Consulta Stock Suizo Argentina",
  "version": "1.0",
  "description": "Consulta rápida de productos por código de barras",
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": [
    "https://web1.suizoargentina.com/*",
    "https://*.suizoargentina.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://web1.suizoargentina.com/*", "https://*.suizoargentina.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}