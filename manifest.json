{
  "manifest_version": 3,
  "name": "Consulta Stock Suizo Argentina",
  "version": "2.3",
  "description": "Consulta rápida de productos por código de barras",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://web1.suizoargentina.com/*",
    "https://*.suizoargentina.com/*",
    "https://www.acofarnet.com/*",
    "https://www.drogueriasur.com.ar/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://web1.suizoargentina.com/*", "https://*.suizoargentina.com/*"],
      "js": ["content-suizo.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.acofarnet.com/*"],
      "js": ["content-acofar.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.drogueriasur.com.ar/*"],
      "js": ["content-sur.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}